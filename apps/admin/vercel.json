{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm turbo run build --filter=@alrmh/admin...",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "ignoreCommand": "npx turbo-ignore @alrmh/admin",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "X-Frame-Options", "value": "DENY" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [{ "source": "/((?!assets/|favicon\\.png).*)", "destination": "/index.html" }]
}
