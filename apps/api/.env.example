# apps/api — copy to apps/api/.env for local work (`pnpm dev:api` loads it).
# On Railway these are the service's variables.

PORT=4000
DATABASE_URL=postgres://alrmh:alrmh@localhost:5432/alrmh
# true for a database that requires TLS from outside its network.
# Railway's internal URL (postgres.railway.internal) does not.
DATABASE_SSL=false

# Where the customer app and the API live, for payment redirects back to the app.
APP_URL=http://localhost:8081
API_URL=http://localhost:4000
# Browser origins allowed to call the API: the customer app and the admin, comma separated.
CORS_ORIGINS=http://localhost:8081,http://localhost:5174

# preview: fixed code below and no SMS. sms: send through the provider (not wired yet,
# so sign-in answers "sms_not_configured"). With NODE_ENV=production and this unset,
# the API uses sms: preview has to be asked for by name.
OTP_MODE=preview
OTP_PREVIEW_CODE=123456
# mock: the test SADAD page. sadad: real payments (not wired yet). With
# NODE_ENV=production and this unset, the API uses sadad and the test page is off.
PAYMENT_MODE=mock

# Per-address limits on sign-in codes and staff sign-in. Only turn off for automated tests.
RATE_LIMITS=on
# Proxies in front of the API, so limits see the caller's real address. Railway: 1 (the production default).
TRUST_PROXY=0

# The first owner of the admin, created on the first start when no staff exist.
ADMIN_EMAIL=owner@alrmh.qa
ADMIN_PASSWORD=change-me-please

# Load the catalogue and settings on start (safe to repeat).
SEED_ON_START=true
# true also loads demo data: the customer 5555 1234 and the coupons EID20 and SUMMER24.
# Anything else, or unset, loads none of it.
SEED_DEMO=true
