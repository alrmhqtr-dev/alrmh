# apps/api — copy to apps/api/.env for local work (`pnpm dev:api` loads it).
# On Railway these are the service's variables.

PORT=4000
DATABASE_URL=postgres://alrmh:alrmh@localhost:5432/alrmh
# true for a database that requires TLS from outside its network.
# Railway's internal URL (postgres.railway.internal) does not.
DATABASE_SSL=false

# Where the customer app and the API live, for payment redirects back to the app.
APP_URL=http://localhost:8081
API_URL=http://localhost:4000
# Browser origins allowed to call the API: the customer app and the admin, comma separated.
CORS_ORIGINS=http://localhost:8081,http://localhost:5174

# preview: fixed code below and no SMS. sms: send through the provider (not wired yet).
OTP_MODE=preview
OTP_PREVIEW_CODE=123456
# mock: the test SADAD page. sadad: real payments (not wired yet).
PAYMENT_MODE=mock

# The first owner of the admin, created on the first start when no staff exist.
ADMIN_EMAIL=owner@alrmh.qa
ADMIN_PASSWORD=change-me-please

# Load the catalogue and settings on start (safe to repeat), and the demo customer 5555 1234.
SEED_ON_START=true
SEED_DEMO=true
