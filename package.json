{
  "name": "alrmh",
  "version": "0.1.0",
  "private": true,
  "description": "AlRmh: customer app (Expo, iOS/Android/PWA), admin web app (React + Vite) and NestJS API monorepo.",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "dev:api": "turbo dev --filter=@alrmh/api",
    "dev:admin": "turbo dev --filter=@alrmh/admin",
    "dev:mobile": "turbo dev --filter=@alrmh/mobile",
    "build:api": "turbo build --filter=@alrmh/api",
    "build:admin": "turbo build --filter=@alrmh/admin",
    "build:mobile": "turbo build --filter=@alrmh/mobile",
    "db:migrate": "pnpm --filter @alrmh/api migrate",
    "db:seed": "pnpm --filter @alrmh/api seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
