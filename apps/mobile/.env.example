# apps/mobile — copy to apps/mobile/.env for local work. Expo reads
# EXPO_PUBLIC_* into the bundle at build time, so every value here is public
# to anyone with the app; nothing secret belongs in this file.
#
# Hosted builds take these from the Vercel project's environment variables
# (web), the Railway service's variables (web, alternative) and eas.json (native).

# Where the API is, without /v1. The local API from `pnpm dev:api`.
EXPO_PUBLIC_API_URL=http://localhost:4000
