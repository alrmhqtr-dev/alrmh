{
  "name": "@alrmh/api",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "dev": "tsc -p . && node --env-file-if-exists=.env dist/main.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "type-check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
