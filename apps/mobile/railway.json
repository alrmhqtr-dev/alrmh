{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/mobile/Dockerfile",
    "watchPatterns": ["apps/mobile/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "turbo.json", ".dockerignore"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
