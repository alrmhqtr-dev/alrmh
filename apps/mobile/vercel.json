{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo run build --filter=@alrmh/mobile...",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "ignoreCommand": "npx turbo-ignore @alrmh/mobile",
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/_expo/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [{ "source": "/((?!_expo/|assets/|icons/|sw\\.js|manifest\\.webmanifest|offline\\.html|favicon\\.ico).*)", "destination": "/index.html" }]
}
